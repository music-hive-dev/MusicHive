  <property name="styleSheet">
   <string notr="true">/* ----- Global ----- */
QWidget {
	font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
	font-size: 10;
}

QMainWindow {
	background-color: #151416;
}

/* ----- Buttons ----- */
QPushButton {
	background-color: #312d34;
	color: #ffffff;
	border-radius: 17px;
	border: 0px solid #ffffff;
	padding: 9px 7px;
}

QPushButton:hover {
    background-color: #433d47;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #6c53a6;
    color: #ffffff;
}

QPushButton:checked {
    background-color: #6c53a6;
    color: #ffffff;
}

QPushButton:checked:hover {
    background-color: #6c53a6;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #222023;
    color: #433d47;
}

/* ----- Horizontal Sliders ----- */
QSlider::groove {
    background-color: #312d34;
    height: 6px;
    border: none;
    border-radius: 3px;
}

QSlider::handle {
    background-color: #6c53a6;
    border: none;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::sub-page {
    background-color: #433d47;
    border: none;
    border-radius: 3px;
}

/* ----- Docks -----*/
QDockWidget {
	background-color: #222023;
    titlebar-close-icon: url(assets/x.svg);
}

QDockWidget QWidget {
    background-color: #222023;
    color: #ffffff;
}

QDockWidget::title {
    background-color: #312d34;
    color: #ffffff;

    text-align: left;
	font-style: bold;
}

QDockWidget::close-button {
    background-color: 312d34;
    border: none;
    border-radius: 4px;

    width: 16px;
    height: 16px;
}

QDockWidget::close-button:hover {
    background-color: #433d47;
}

QDockWidget::close-button:pressed {
    background-color: #6c53a6;
}

/* ----- Menu bar and status bar ----- */
QMenuBar {
    background-color: #151416;
    color: #433d47;

    border: none;

    padding: 4px 6px;

    font-family: &quot;Inter&quot;;
    font-size: 13px;
    font-weight: 500;
}</string>
  </property>
