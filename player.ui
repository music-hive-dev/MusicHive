  <property name="styleSheet">
   <string notr="true">
/* =================================
   Minimal Dark Qt Stylesheet
   Flat colours / No borders
   ================================= */

/* Global */
QWidget {
    background-color: #17191D;
    color: #E0E2E6;
    font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 10pt;
    border: none;
}

/* Main window */
QMainWindow {
    background-color: #17191D;
}

/* Labels */
QLabel {
    background: transparent;
    color: #E0E2E6;
}

/* Buttons */
QPushButton {
    background-color: #30343C;
    color: #E0E2E6;
    border: none;
    border-radius: 9px;
    padding: 9px 16px;
}

QPushButton:hover {
    background-color: #3A3F49;
}

QPushButton:pressed {
    background-color: #454B57;
}

QPushButton:disabled {
    background-color: #24272D;
    color: #666C76;
}

/* Primary button */
QPushButton#primaryButton {
    background-color: #668DB8;
    color: #FFFFFF;
}

QPushButton#primaryButton:hover {
    background-color: #779BC3;
}

QPushButton#primaryButton:pressed {
    background-color: #527BA6;
}

/* Input fields */
QLineEdit,
QTextEdit,
QPlainTextEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #24272D;
    color: #E0E2E6;
    border: none;
    border-radius: 9px;
    padding: 9px;
    selection-background-color: #668DB8;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QSpinBox:focus {
    background-color: #2C3038;
}

/* Combo boxes */
QComboBox {
    background-color: #24272D;
    color: #E0E2E6;
    border: none;
    border-radius: 9px;
    padding: 9px 12px;
}

QComboBox:hover {
    background-color: #30343C;
}

QComboBox QAbstractItemView {
    background-color: #24272D;
    color: #E0E2E6;
    border: none;
    selection-background-color: #363D48;
    selection-color: #FFFFFF;
    outline: none;
}

/* Checkboxes */
QCheckBox {
    spacing: 9px;
    background: transparent;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 5px;
    border: none;
    background-color: #363A43;
}

QCheckBox::indicator:checked {
    background-color: #668DB8;
}

/* Radio buttons */
QRadioButton {
    spacing: 8px;
    background: transparent;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: #363A43;
}

QRadioButton::indicator:checked {
    background-color: #668DB8;
}

/* Group boxes */
QGroupBox {
    background-color: #22252B;
    border: none;
    border-radius: 12px;
    margin-top: 16px;
    padding: 14px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #AEB4BE;
}

/* Tabs */
QTabWidget::pane {
    background-color: #22252B;
    border: none;
    border-radius: 10px;
}

QTabBar::tab {
    background-color: transparent;
    color: #9299A4;
    padding: 10px 16px;
    margin-right: 4px;
    border: none;
    border-radius: 8px;
}

QTabBar::tab:selected {
    background-color: #30343C;
    color: #FFFFFF;
}

QTabBar::tab:hover {
    background-color: #282C33;
}

/* Tables */
QTableWidget,
QTableView {
    background-color: #22252B;
    alternate-background-color: #272A31;
    border: none;
    border-radius: 10px;
    gridline-color: transparent;
    selection-background-color: #363D48;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #282C33;
    color: #AEB4BE;
    border: none;
    padding: 10px;
    font-weight: bold;
}

/* Sliders */
QSlider::groove:horizontal {
    background-color: #363A43;
    height: 5px;
    border: none;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #668DB8;
    width: 15px;
    height: 15px;
    margin: -5px 0;
    border: none;
    border-radius: 7px;
}

/* Progress bars */
QProgressBar {
    background-color: #30343C;
    border: none;
    border-radius: 5px;
    text-align: center;
    height: 10px;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #668DB8;
    border: none;
    border-radius: 5px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: transparent;
    width: 9px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #454B55;
    border: none;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #59616E;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
</string>
