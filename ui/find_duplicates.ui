         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>10</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </item>
     <item row="1" column="1">
      <widget class="QCheckBox" name="findDupesShowSkipped">
       <property name="text">
        <string>Include songs marked as not duplicates</string>
       </property>
       <property name="toolTip">
        <string>Also look at the songs that were marked as not duplicates, so the mark can be taken off again</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
    </layout>
