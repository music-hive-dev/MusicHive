   </rect>
  </property>
  <property name="windowTitle">
   <string>Find Duplicates</string>
  </property>
  <layout class="QVBoxLayout" name="findDupesLayout">
   <item>
    <widget class="QLabel" name="findDupesIntro">
     <property name="text">
      <string>Finds songs that are in the library more than once. Choose a song to see its copies, listen to them, and keep the best one: the others go to the Trash, and their plays, rating and places in playlists pass to the one you keep.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="findDupesOptions">
     <item row="0" column="0">
      <widget class="QCheckBox" name="findDupesIgnoreNotes">
       <property name="text">
        <string>Ignore notes such as “(Remastered 2011)” or “- Single Version”</string>
       </property>
       <property name="toolTip">
        <string>Notes about live, acoustic, demo, remix or instrumental versions still count, so those stay apart</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QCheckBox" name="findDupesSameAlbum">
       <property name="text">
        <string>Only copies on the same album</string>
       </property>
       <property name="toolTip">
        <string>Leave out a song that is on an album and a compilation</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <layout class="QHBoxLayout" name="findDupesLengthRow">
       <item>
        <widget class="QCheckBox" name="findDupesSameLength">
         <property name="text">
          <string>Only when their lengths differ by at most</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLineEdit" name="findDupesLengthSeconds">
         <property name="maximumSize">
          <size>
           <width>80</width>
           <height>16777215</height>
          </size>
         </property>
         <property name="toolTip">
          <string>Type a number, or use the Up and Down keys</string>
         </property>
         <property name="minimum" stdset="0">
          <number>0</number>
         </property>
         <property name="maximum" stdset="0">
          <number>60</number>
         </property>
         <property name="value" stdset="0">
          <number>3</number>
         </property>
         <property name="suffix" stdset="0">
          <string> s</string>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="findDupesLengthSpacer">
