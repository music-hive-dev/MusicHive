  <property name="styleSheet">
   <string notr="true">/* ----- Global ----- */
QWidget {
	font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
	color: #ffffff;
	selection-background-color: #6c53a6;
	selection-color: #ffffff;
}

QWidget:disabled {
	color: rgba(255, 255, 255, 85);
}

QMainWindow {
	background-color: #151416;
}

/* ----- Buttons ----- */
QPushButton {
	background-color: #312d34;
	color: #ffffff;
	border-radius: 17px;
	border: 0px solid #ffffff;
	padding: 9px 7px;
}

QPushButton:hover {
    background-color: #433d47;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #6c53a6;
    color: #ffffff;
}

QPushButton:checked {
    background-color: #6c53a6;
    color: #ffffff;
}

QPushButton:checked:hover {
    background-color: #6c53a6;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: rgba(49, 45, 52, 128);
    color: rgba(255, 255, 255, 85);
}

/* ----- Horizontal Sliders ----- */
QSlider::groove:horizontal {
    background-color: #312d34;
    height: 6px;
    border: none;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #6c53a6;
    border: none;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::sub-page:horizontal {
    background-color: #433d47;
    border: none;
    border-radius: 3px;
}

/* ----- Vertical Sliders ----- */
QSlider::groove:vertical {
    background-color: #312d34;
    width: 6px;
    border: none;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background-color: #6c53a6;
    border: none;
    width: 14px;
    height: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}

QSlider::add-page:vertical {
    background-color: #433d47;
    border: none;
    border-radius: 3px;
}

/* ----- Docks -----*/
QDockWidget {
	background-color: #222023;
    titlebar-close-icon: url(assets/x.svg);
}

QDockWidget &gt; QWidget {
    background-color: #222023;
}

QDockWidget::title {
    background-color: #312d34;
    color: #ffffff;

    text-align: left;
	font-style: bold;
}

QDockWidget::close-button {
    background-color: #312d34;
    border: none;
    border-radius: 4px;

    width: 16px;
    height: 16px;
}

QDockWidget::close-button:hover {
    background-color: #433d47;
}

QDockWidget::close-button:pressed {
    background-color: #6c53a6;
}

/* ----- Menu bar and status bar ----- */
QMenuBar {
    background-color: #151416;
    color: rgba(255, 255, 255, 170);

    border: none;

    padding: 1px 4px;
    spacing: 0px;

    font-family: &quot;Inter&quot;;
    font-size: 9pt;
    font-weight: 500;
}

/* ----- Small controls ----- */
QComboBox::down-arrow {
    image: url(assets:chevron-down.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(assets:chevron-up.svg);
    width: 10px;
    height: 10px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(assets:chevron-down.svg);
    width: 10px;
    height: 10px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

QCheckBox::indicator:unchecked {
    image: url(assets:square.svg);
}

QCheckBox::indicator:checked {
    image: url(assets:square-check-big.svg);
}

QHeaderView::up-arrow {
    image: url(assets:chevron-up.svg);
    width: 10px;
    height: 10px;
}

QHeaderView::down-arrow {
    image: url(assets:chevron-down.svg);
    width: 10px;
    height: 10px;
}

QTabBar QToolButton::left-arrow {
    image: url(assets:chevron-left.svg);
}

QTabBar QToolButton::right-arrow {
    image: url(assets:chevron-right.svg);
}

/* ----- Scrollbars ----- */
QScrollBar:vertical {
    background-color: #222023;
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar:horizontal {
    background-color: #222023;
    height: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle {
    background-color: #433d47;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
}

QScrollBar::handle:hover {
    background-color: #6c53a6;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* ----- Less important text ----- */
QLabel#playlistsTabDescription,
QLabel#playlistsTabStats,
QLabel#artistsTabDescription,
QLabel#artistsTabStats,
QLabel#albumsTabArtist,
QLabel#albumsTabYear,
QLabel#albumsTabStats,
QLabel#deviceInfoNameLabel,
QLabel#deviceInfoBatteryLabel,
QLabel#deviceInfoModelLabel,
QLabel#deviceInfoCapacityLabel,
QLabel#deviceInfoFirmwareLabel,
QLabel#deviceInfoFreeLabel,
QLabel#deviceInfoSerialLabel,
QLabel#deviceInfoSpaceLabel,
QLabel#deviceInfoConnectionLabel,
QLabel#deviceInfoFileSystemLabel,
QLabel#deviceInfoStorageLabel,
QLabel#deviceInfoLocationLabel,
QLabel#syncMusicFolderLabel,
QLabel#syncPlaylistFolderLabel,
QLabel#syncPlaylistsLabel,
QLabel#syncFormatLabel,
QLabel#syncProfileLabel,
QLabel#syncStatus {
    color: rgba(255, 255, 255, 170);
}

/* ----- Windows and dialogs ----- */
QDialog {
    background-color: #222023;
}

QScrollArea {
    background: transparent;
    border: none;
}

QToolTip {
    background-color: #312d34;
    color: #ffffff;
    font-family: &quot;Inter&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 9pt;
    border: none;
    border-radius: 8px;
    padding: 2px 6px;
}

/* ----- Tabs: only the selected tab has a shape, so inactive icons stay centred ----- */
QWidget#centralwidget, QTabWidget#podcastsTab, QTabWidget#podcastsTab &gt; QStackedWidget &gt; QWidget {
    background-color: #222023;
}

QTabWidget::pane {
    border: none;
    background-color: #222023;
}

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background: transparent;
    color: rgba(255, 255, 255, 170);
}

QTabBar::tab:selected {
    background-color: #6c53a6;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    padding: 6px 14px;
}

/* ----- Text fields ----- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #312d34;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    padding: 6px 12px;
    placeholder-text-color: rgba(255, 255, 255, 170);
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    background-color: #433d47;
}

/* ----- Horizontal lines, the same as the outlines of lists and tables ----- */
QFrame#line, QFrame#line_2 {
    background-color: #312d34;
    border: none;
    min-height: 1px;
    max-height: 1px;
}

/* ----- Dropdowns and number boxes ----- */
QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #312d34;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    padding: 6px 12px;
}

/* The box around it already has the padding and shape */
QSpinBox QLineEdit, QDoubleSpinBox QLineEdit {
    background: transparent;
    border-radius: 0px;
    padding: 0px;
}

/* The equaliser's number boxes are narrow */
QDialog#equaliserWindow QLineEdit {
    border-radius: 12px;
    padding: 2px;
    min-height: 20px;
    min-width: 36px;
}

QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    background-color: #433d47;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

/* A plain list instead of Qt's menu-like popup, which adds bars above and below */
QComboBox {
    combobox-popup: 0;
}

QComboBoxPrivateContainer {
    background: transparent;
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #312d34;
    color: #ffffff;
    border: none;
    border-radius: 14px;
    padding: 4px;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    border-radius: 10px;
    padding: 3px 8px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 20px;
    border: none;
    background: transparent;
}

QCheckBox {
    spacing: 8px;
}

/* ----- Menus ----- */
QMenuBar::item {
    background: transparent;
    padding: 2px 6px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background-color: #312d34;
    color: #ffffff;
}

QMenu {
    background-color: #222023;
    color: #ffffff;
    border: 1px solid #312d34;
    border-radius: 14px;
    padding: 4px;
}

QMenu::item {
    padding: 3px 16px 3px 8px;
    border-radius: 10px;
}

QMenu::item:selected {
    background-color: #6c53a6;
    color: #ffffff;
}

QMenu::item:disabled {
    background: transparent;
    color: rgba(255, 255, 255, 85);
}

QMenu::separator {
    height: 1px;
    background-color: #312d34;
    margin: 2px 6px;
}

QMenu::indicator:non-exclusive:checked {
    image: url(assets:check.svg);
    width: 14px;
    height: 14px;
}

/* ----- Lists and tables ----- */
QAbstractItemView {
    background-color: transparent;
    alternate-background-color: rgba(49, 45, 52, 128);
    color: #ffffff;
    border: none;
    outline: 0;
}

/* The view's own stripes are square, so each row draws a rounded one */
QListView, QTableView {
    alternate-background-color: rgba(0, 0, 0, 0);
}

QListView::item:alternate, QTableView::item:alternate {
    background-color: rgba(49, 45, 52, 128);
}

QAbstractItemView::item:hover {
    background-color: #312d34;
}

QAbstractItemView::item:selected {
    background-color: #6c53a6;
    color: #ffffff;
}

QListView::item, QTreeView::item {
    border-radius: 10px;
}

/* A table row is rounded by the outer corners of its first and last cell */
QTableView::item:first {
    border-top-left-radius: 10px;
    border-bottom-left-radius: 10px;
}

QTableView::item:last {
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
}

QTableView::item:only-one {
    border-radius: 10px;
}

QTableView {
    /* Otherwise a square selection is drawn behind the rounded one */
    selection-background-color: rgba(0, 0, 0, 0);
    show-decoration-selected: 0;
    gridline-color: transparent;
    border: 1px solid #312d34;
    border-radius: 14px;
    padding: 3px;
}

QListView#upcomingList,
QListView#thisList,
QListView#songFilterList,
QListView#artistFilterList,
QListView#albumFilterList {
    border: 1px solid #312d34;
    border-radius: 14px;
    padding: 3px;
}

/* Scrollbars stop short of the rounded corners of an outline */
QTableView QScrollBar:vertical,
QListView#upcomingList QScrollBar:vertical,
QListView#thisList QScrollBar:vertical,
QListView#songFilterList QScrollBar:vertical,
QListView#artistFilterList QScrollBar:vertical,
QListView#albumFilterList QScrollBar:vertical {
    margin: 12px 0px;
}

QTableView QScrollBar:horizontal {
    margin: 0px 12px;
}

/* Clear of the outline's rounded corners */
QTableView QScrollBar:vertical {
    background: transparent;
    margin: 14px 0;
}

QTableView QScrollBar:horizontal {
    background: transparent;
    margin: 0 14px;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background: transparent;
    color: rgba(255, 255, 255, 170);
    border: none;
    padding: 6px 8px;
}

QTableCornerButton::section {
    background: transparent;
    border: none;
}

/* ----- Progress bars and status bar ----- */
QProgressBar {
    background-color: #312d34;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #6c53a6;
    border-radius: 8px;
}

QStatusBar {
    background-color: #151416;
    color: rgba(255, 255, 255, 170);
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    background: transparent;
    color: rgba(255, 255, 255, 170);
}</string>
