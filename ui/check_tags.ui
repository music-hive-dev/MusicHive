  <property name="windowTitle">
   <string>Check Tags</string>
  </property>
  <layout class="QVBoxLayout" name="checkTagsLayout">
   <item>
    <widget class="QLabel" name="checkTagsIntro">
     <property name="text">
      <string>Looks through the tags of the library and lists the albums and artists that need tidying up. Choose one to see its songs, with the tags that are wrong marked. Albums you are happy with can be marked to skip: that is saved in their songs' tags.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <layout class="QGridLayout" name="checkTagsOptions">
     <item row="0" column="0">
      <widget class="QLabel" name="checkTagsMissingLabel">
       <property name="text">
        <string>Songs without:</string>
       </property>
      </widget>
     </item>
     <item row="0" column="1" colspan="3">
      <layout class="QHBoxLayout" name="checkTagsMissingRow">
       <item>
        <widget class="QCheckBox" name="checkTagsMissingTitle">
         <property name="text">
          <string>Title</string>
         </property>
         <property name="checked">
