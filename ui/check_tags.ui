         <property name="text">
          <string>Genre</string>
         </property>
         <property name="checked">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="checkTagsMissingTrack">
         <property name="text">
          <string>Track number</string>
         </property>
         <property name="toolTip">
          <string>Only songs that belong to an album</string>
         </property>
         <property name="checked">
