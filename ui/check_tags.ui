     </item>
     <item row="1" column="0" colspan="2">
      <widget class="QCheckBox" name="checkTagsDuplicates">
       <property name="text">
        <string>Duplicate or impossible track numbers</string>
       </property>
       <property name="toolTip">
        <string>Two songs of one disc with the same number, or a number above the disc's track total</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="1" column="2" colspan="2">
      <widget class="QCheckBox" name="checkTagsGaps">
       <property name="text">
        <string>Gaps in track numbers</string>
       </property>
       <property name="toolTip">
        <string>Numbers missing between 1 and the highest one: a song may be missing, or numbered wrongly</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
      </widget>
     </item>
     <item row="2" column="0" colspan="2">
      <widget class="QCheckBox" name="checkTagsMixed">
       <property name="text">
        <string>Albums whose songs disagree on year, album artist or album name</string>
       </property>
       <property name="checked">
        <bool>true</bool>
       </property>
