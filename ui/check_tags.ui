       <property name="text">
        <string>Albums whose songs have different genres</string>
       </property>
       <property name="checked">
        <bool>false</bool>
       </property>
      </widget>
     </item>
     <item row="3" column="0" colspan="2">
      <widget class="QCheckBox" name="checkTagsSpellings">
       <property name="text">
        <string>Artists written more than one way</string>
       </property>
       <property name="toolTip">
        <string>Such as “The Beatles” and “Beatles”, or “Simon &amp; Garfunkel” and “Simon and Garfunkel”</string>
       </property>
