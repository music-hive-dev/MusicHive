  <layout class="QVBoxLayout" name="checkCoversLayout">
   <item>
    <widget class="QLabel" name="checkCoversIntro">
     <property name="text">
      <string>Looks at the cover of every album and lists those that need a better one. Double-click an album to edit its songs, or use Find Cover to search the internet for its cover straight away. Albums you are happy with can be marked to skip: that is saved in their songs' tags.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
