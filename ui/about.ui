   <item>
    <widget class="QLabel" name="aboutText">
     <property name="text">
      <string>&lt;h2&gt;MusicHive&lt;/h2&gt;
&lt;p&gt;Version 1.2.4&lt;/p&gt;
&lt;p&gt;A desktop music player and organiser for people who keep their music in folders.&lt;/p&gt;
&lt;p&gt;MusicHive plays your local library with playlists, auto-playlists, a queue, crossfades, an equaliser and timed lyrics. It also helps keep the library tidy: edit tags for many songs at once, find covers and genres online, sort files into folders from a naming template, convert them to other formats and sync them to a portable player.&lt;/p&gt;
&lt;p&gt;It works with Last.fm, Discord and your desktop's media controls.&lt;/p&gt;
&lt;h3&gt;Libraries&lt;/h3&gt;
&lt;p&gt;
&lt;a href=&quot;https://www.qt.io/qt-for-python&quot;&gt;PySide6 (Qt for Python)&lt;/a&gt;, LGPL-3.0&lt;br&gt;
&lt;a href=&quot;https://gstreamer.freedesktop.org&quot;&gt;GStreamer&lt;/a&gt;, LGPL-2.1&lt;br&gt;
&lt;a href=&quot;https://pygobject.gnome.org&quot;&gt;PyGObject&lt;/a&gt;, LGPL-2.1&lt;br&gt;
&lt;a href=&quot;https://github.com/quodlibet/mutagen&quot;&gt;Mutagen&lt;/a&gt;, GPL-2.0-or-later
&lt;/p&gt;
&lt;h3&gt;Artwork&lt;/h3&gt;
&lt;p&gt;
Icons by &lt;a href=&quot;https://lucide.dev&quot;&gt;Lucide&lt;/a&gt;, ISC License. Some are derived from Feather, MIT License.&lt;br&gt;
Emoji by &lt;a href=&quot;https://github.com/twitter/twemoji&quot;&gt;Twemoji&lt;/a&gt;, &lt;a href=&quot;https://creativecommons.org/licenses/by/4.0/&quot;&gt;CC BY 4.0&lt;/a&gt;, in the &lt;a href=&quot;https://github.com/mozilla/twemoji-colr&quot;&gt;Twemoji Mozilla&lt;/a&gt; font.
&lt;/p&gt;</string>
     </property>
     <property name="textFormat">
      <enum>Qt::TextFormat::RichText</enum>
